# Installers keep the line endings their shell needs, whatever core.autocrlf
# says on the machine that checked them out: bash chokes on a CR, and Windows
# PowerShell 5.1 is happiest with CRLF.
*.sh    text eol=lf
*.ps1   text eol=crlf

